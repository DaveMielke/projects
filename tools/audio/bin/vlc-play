#!/bin/bash
set -e

programName="${0##*/}"

vlcOptions=(
  --quiet
  --aout pulse
  --sout-keep
  --intf rc

  --logfile "${TMPDIR:-/tmp}/${programName}.log"
  --logmode text
  --log-verbose -1

  --started-from-file
  --one-instance-when-started-from-file

  --play-and-exit
  --no-playlist-enqueue

  --audio
  --no-video

  --audio-replay-gain-mode track
  --audio-replay-gain-peak-protection
)

soundFonts=(
  /usr/share/soundfonts/FluidR3_GM.sf2
  /usr/share/sounds/FluidR3_GM.sf2
)

for font in "${soundFonts[@]}"
do
  if [ -f "${font}" ]
  then
    vlcOptions+=(
      --soundfont "${font}"
      --synth-gain 2
      --synth-polyphony 100
      --synth-sample-rate 44100
      --no-synth-chorus
      --synth-reverb
    )

    break
  fi
done

exec vlc "${vlcOptions[@]}" "${@}"
exit "${?}"
